# Copy to config/pc.env and adjust for this computer. Do not commit pc.env.
# Serial path may be overridden by ARMPI_SERIAL_PORT in the environment.
export ARMPI_SERIAL_PORT="${ARMPI_SERIAL_PORT:-/dev/serial/by-id/REPLACE_WITH_YOUR_DEVICE}"
export ARMPI_BAUDRATE="${ARMPI_BAUDRATE:-1000000}"
# Set according to the attached hardware: None / Mecanum / Tank / Slide_Rails.
export CHASSIS_TYPE="${CHASSIS_TYPE:-None}"
export CAMERA_TYPE="${CAMERA_TYPE:-usb_cam}"
export MACHINE_TYPE="${MACHINE_TYPE:-ArmPiUltra}"
export ARMPI_VIDEO_DEVICE="${ARMPI_VIDEO_DEVICE:-/dev/video0}"
export ASR_LANGUAGE="${ASR_LANGUAGE:-English}"
export ARMPI_ACTION_GROUP_PATH="${ARMPI_ACTION_GROUP_PATH:-${ARMPI_WS}/software/armpi_ultra_control/ActionGroups}"
